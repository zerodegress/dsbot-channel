{
  "name": "dsbot-channel",
  "version": "0.1.0",
  "description": "A message gateway for ds-bot: events from several external platforms reach one bot, and answers go back to the conversation they came from",
  "keywords": [
    "cordis",
    "dsbot",
    "deepseek",
    "chatbot",
    "gateway",
    "messaging"
  ],
  "homepage": "https://github.com/zerodegress/dsbot-channel",
  "bugs": {
    "url": "https://github.com/zerodegress/dsbot-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodegress/dsbot-channel.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README_ZH.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm clean && rolldown -c && tsc -p tsconfig.json",
    "build:debug": "SOURCE_MAP=1 pnpm build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@eslint/js": "~10.0.1",
    "@types/node": "~22.20.5",
    "eslint": "~10.13.0",
    "rolldown": "~1.2.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "~5.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
